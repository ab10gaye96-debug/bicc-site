rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin (by checking users collection)
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'Manager', 'Staff', 'Editor'];
    }
    
    // Helper function to check if user is Super Admin
    function isSuperAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
    
    // Page Content - Public read, Admin write
    match /pageContent/{section} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Site Settings - Public read, Admin write (CRITICAL: Frontend needs to read this!)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Media Library - Public read, Admin write (CRITICAL: Frontend needs to read uploaded images!)
    match /mediaLibrary/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit logs - Admin only
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
    
    // Username lookup for admin login
    match /adminUsernames/{username} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isSuperAdmin() || (isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // Users collection - Super Admin can manage all, users can read their own
    match /users/{userId} {
      allow read: if isSignedIn() && (
        userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        resource.data.email == request.auth.token.email ||
        isSuperAdmin()
      );
      allow create: if isSuperAdmin() || (isSignedIn() && userId == request.auth.uid);
      allow update, delete: if isSuperAdmin(); // Only Super Admin can delete/modify others
    }
    
    // Events
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // News
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Gallery
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Venues
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bookings
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // Contacts
    match /contacts/{contactId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }
    
    // Testimonials
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Partners
    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Team Members (Board of Directors & BICC Team)
    match /teamMembers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Downloads
    match /downloads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Vacancies/Careers
    match /vacancies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Applications
    match /applications/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }
    
    // Tenders
    match /tenders/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Subscribers
    match /subscribers/{id} {
      allow read, delete: if isAdmin();
      allow create: if true;
    }
    
    // Pricing
    match /pricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Quotations
    match /quotations/{id} {
      allow read, write: if isAdmin();
    }
    
    // Hotels
    match /hotels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
