rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin (logged in)
    function isAdmin() {
      return isAuthenticated();
    }
    
    // Site Settings - Only admins can read/write
    match /siteSettings/{document=**} {
      allow read: if true; // Anyone can read site settings (for public website)
      allow write: if isAdmin(); // Only authenticated admins can write
    }

    // CMS page content - Public read, admin write
    match /pageContent/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Media Library - Only admins can manage
    match /mediaLibrary/{document=**} {
      allow read: if true; // Anyone can read (for displaying images)
      allow write: if isAdmin(); // Only authenticated admins can upload/edit
    }
    
    // Events - Public read, admin write
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // News - Public read, admin write
    match /news/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Contacts - Anyone can create, only admins can read/update/delete
    match /contacts/{document=**} {
      allow create: if true; // Contact form submission
      allow read, update, delete: if isAdmin();
    }
    
    // Bookings - Anyone can create, only admins can read/update/delete
    match /bookings/{document=**} {
      allow create: if true; // Booking form submission
      allow read, update, delete: if isAdmin();
    }
    
    // Gallery - Public read, admin write
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Venues - Public read, admin write
    match /venues/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users - Only admins can read/write (sensitive data)
    match /users/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Testimonials - Public read, admin write
    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Partners - Public read, admin write
    match /partners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Downloads - Public read, admin write
    match /downloads/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Vacancies/Careers - Public read, admin write
    match /vacancies/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Job Applications - Anyone can create, only admins can read/delete
    match /applications/{document=**} {
      allow create: if true; // Job application submission
      allow read, update, delete: if isAdmin();
    }
    
    // Tenders - Public read, admin write
    match /tenders/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Subscribers - Anyone can create, only admins can read/delete
    match /subscribers/{document=**} {
      allow create: if true; // Newsletter subscription
      allow read, delete: if isAdmin();
    }
    
    // Pricing - Public read, admin write
    match /pricing/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Quotations - Anyone can create, only admins can read/update/delete
    match /quotations/{document=**} {
      allow create: if true; // Quotation request submission
      allow read, update, delete: if isAdmin();
    }

    // Hotels - Public read, admin write
    match /hotels/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
