# BICC configuration
PORT=3001
JWT_SECRET=your-super-secret-key-change-this-in-production

# Public site admin routing
# Set this in production to send `/admin` traffic to the separate secure admin portal.
VITE_ADMIN_PORTAL_URL=https://admin.example.com

# Set to `true` only if you intentionally want to expose the embedded admin on this build.
VITE_ENABLE_EMBEDDED_ADMIN=false
