rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'Manager', 'Staff'];
    }
    
    // Page Content - Public read, Admin write
    match /pageContent/{section} {
      allow read: if true; // Anyone can read
      allow write: if isAdmin(); // Only authenticated admins can write
    }
    
    // Users collection
    match /users/{userId} {
      allow read, write: if isAdmin();
    }
    
    // Events
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // News
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Gallery
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Venues
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bookings
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if true; // Public can create
      allow update, delete: if isAdmin();
    }
    
    // Contacts
    match /contacts/{contactId} {
      allow read, update, delete: if isAdmin();
      allow create: if true; // Public can submit
    }
    
    // Testimonials
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Partners
    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Downloads
    match /downloads/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Vacancies/Careers
    match /vacancies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Applications
    match /applications/{id} {
      allow read, write: if isAdmin();
    }
    
    // Tenders
    match /tenders/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Subscribers
    match /subscribers/{id} {
      allow read, delete: if isAdmin();
      allow create: if true; // Public can subscribe
    }
    
    // Pricing
    match /pricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Quotations
    match /quotations/{id} {
      allow read, write: if isAdmin();
    }
    
    // Hotels
    match /hotels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
