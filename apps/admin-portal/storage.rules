rules_version = '2';

// Firebase Storage Security Rules for BICC Admin Portal
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && userExists()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          in ['Super Admin', 'Manager', 'Staff', 'Editor'];
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidImageSize() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    function isValidVideoSize() {
      return request.resource.size < 100 * 1024 * 1024;
    }

    function isValidUpload() {
      return isAdmin() && (
        (isImage() && isValidImageSize()) ||
        (isVideo() && isValidVideoSize()) ||
        (!isImage() && !isVideo() && isValidImageSize())
      );
    }

    match /media/{category}/{fileName} {
      allow read: if true;
      allow write: if isValidUpload();
      allow delete: if isAdmin();
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (isValidImageSize() || isValidVideoSize());
      allow delete: if isAdmin();
    }

    match /venues/{venueId}/{fileName} {
      allow read: if true;
      allow write: if isValidUpload();
      allow delete: if isAdmin();
    }

    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isValidImageSize();
      allow delete: if isAdmin();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isValidUpload();
      allow delete: if isAdmin();
    }

    match /documents/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageSize();
      allow delete: if isAdmin();
    }

    match /content/{folder}/{fileName} {
      allow read: if true;
      allow write: if isValidUpload();
      allow delete: if isAdmin();
    }

    match /resumes/{fileName} {
      allow read: if true;
      allow create: if isValidImageSize() || isValidVideoSize();
      allow update, delete: if isAdmin();
    }

    match /partners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isValidImageSize();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
